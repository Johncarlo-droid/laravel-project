APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PRODUCTION EMAIL (verification codes will NOT reach real inboxes without
# this). MAIL_MAILER=log above is fine for local testing only -- it just
# writes the "email" into storage/logs/laravel.log instead of sending it,
# which is why codes worked on localhost but never arrived once deployed.
#
# To actually send real emails in production, sign up free at brevo.com,
# go to Settings > SMTP & API > SMTP, and set these on your HOST (Railway
# dashboard env vars, or this .env file on the server -- not on localhost):
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=your-brevo-login-email@example.com
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_FROM_ADDRESS="noreply@yourdomain-or-brevo-verified-sender.com"
# MAIL_FROM_NAME="NU Clark Asset Management System"
#
# Any SMTP provider works the same way (Gmail SMTP, Outlook SMTP, Mailgun,
# etc.) -- just swap these 6 values for whichever provider's SMTP details.
# The recipient can still be any email address (Gmail, Outlook, anything);
# these settings only control who is SENDING the mail, not who can receive it.
# ---------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=change-this-to-a-long-random-secret
JWT_TTL=120
BCRYPT_ROUNDS=12
